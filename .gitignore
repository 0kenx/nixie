# --- Benchmark corpora are NOT tracked in git ---
# smt-lib / satlib / satcomp are multi-hundred-thousand-file external
# benchmark suites (SMT-LIB, SATLIB, SAT Competition). Fetch them out of band
# (see bench/differential/README.md) and keep them as plain working-tree data;
# do not commit them. Tests that consume specific instances
# (oxiz-solver/tests/known_unsound_regressions.rs) and the differential harness
# (bench/differential/) skip cleanly when a file is absent.
/smt-lib/
/satlib/
/satcomp2024/
/satcomp2025/

# Local bench / profiling artifacts (not the harness itself)
perf.data
perf.data.old
/target-baseline/
/target-bench/

# Prebuilt solver binaries cached per commit SHA (see AGENTS.md →
# "Git: precompile binary cache"); never commit binaries
/precompile/

# Rustc ICE dumps
rustc-ice-*.txt

# Nix / direnv (generated shell cache; .envrc stays tracked)
.direnv/
/result
/result-*
/outputs/
