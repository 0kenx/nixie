+#[test]
+fn predicates_preserve_bits_above_sixty_four() {
+    // Exact 128-bit boundaries, independent of host integer conversions.
+    let min = "170141183460469231731687303715884105728";
+    let max = "340282366920938463463374607431768211455";
+    for expression in [
+        format!("(bvnego (_ bv{min} 128))"),
+        format!("(bvuaddo (_ bv{max} 128) (_ bv1 128))"),
+        format!("(bvssubo (_ bv{min} 128) (_ bv1 128))"),
+        format!("(bvsmulo (_ bv{min} 128) (_ bv{max} 128))"),
+        "(bvumulo (_ bv18446744073709551616 128) (_ bv18446744073709551616 128))".into(),
+    ] {
+        for (term, verdict) in [
+            (expression.clone(), "sat"),
+            (format!("(not {expression})"), "unsat"),
+        ] {
+            assert_eq!(decide(&format!("(assert {term})(check-sat)")), verdict);
+        }
+    }
+}
