+#[test]
+fn predicates_at_width_one() {
+    for predicate in BINARY_PREDICATES {
+        for a in 0..2 {
+            for b in 0..2 {
+                check_case(predicate, a, b, 1);
+            }
+        }
+    }
+    for a in 0..2 {
+        check_case("bvnego", a, 0, 1);
+    }
+}
