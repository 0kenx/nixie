+#[test]
+fn overflow_predicates_reject_bad_arity_and_product_width() {
+    for predicate in BINARY_PREDICATES {
+        for operands in ["", "#b0", "#b0 #b0 #b0", "true false"] {
+            assert!(decide(&format!("(assert ({predicate} {operands}))")).starts_with("error:"));
+        }
+    }
+    for operands in ["", "#b0 #b0"] {
+        assert!(decide(&format!("(assert (bvnego {operands}))")).starts_with("error:"));
+    }
+    for predicate in ["bvumulo", "bvsmulo"] {
+        // Reject before constructing any huge constants or intermediate DAG.
+        let input = format!("(declare-const x (_ BitVec 2147483648))(assert ({predicate} x x))");
+        assert!(decide(&input).starts_with("error:"));
+    }
