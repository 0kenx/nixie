(set-logic QF_NRT)
(declare-const x0 Real) (declare-const x1 Real) (declare-const x2 Real)
(declare-const x3 Real) (declare-const x4 Real) (declare-const x5 Real)
(declare-const x6 Real) (declare-const x7 Real) (declare-const x8 Real)
(declare-const x9 Real)
(assert (and (>= (sin x0) 0.5) (>= x0 0.0) (<= x0 1.0)))
(assert (and (>= (sin x1) 0.5) (>= x1 0.0) (<= x1 1.0)))
(assert (and (>= (sin x2) 0.5) (>= x2 0.0) (<= x2 1.0)))
(assert (and (>= (sin x3) 0.5) (>= x3 0.0) (<= x3 1.0)))
(assert (and (>= (sin x4) 0.5) (>= x4 0.0) (<= x4 1.0)))
(assert (and (>= (sin x5) 0.5) (>= x5 0.0) (<= x5 1.0)))
(assert (and (>= (sin x6) 0.5) (>= x6 0.0) (<= x6 1.0)))
(assert (and (>= (sin x7) 0.5) (>= x7 0.0) (<= x7 1.0)))
(assert (and (>= (sin x8) 0.5) (>= x8 0.0) (<= x8 1.0)))
(assert (and (<= (sin x9) -2.0) (>= x9 0.0) (<= x9 1.0)))
(check-sat)
