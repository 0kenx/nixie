; Test: small Pythagorean triple
; Expected: sat
(set-logic QF_NIA)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assert (= (+ (* x x) (* y y)) (* z z)))
(assert (> x 0))
(assert (> y 0))
(assert (> z 0))
(assert (<= x 20))
(assert (<= y 20))
(assert (<= z 20))
(assert (<= x y))
(check-sat)
