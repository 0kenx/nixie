; Semantic counterparts of the direct Rust API probes. Run with Z3 4.16.0.
(echo "integer parity: expected unsat")
(declare-const x Int)
(assert (<= (+ x x) 1))
(assert (<= (- (+ x x)) (- 1)))
(check-sat)
(reset)
(echo "real strict: expected unsat")
(declare-const x Real)
(assert (< x 0))
(assert (>= x 0))
(check-sat)
(reset)
(echo "integer fractional strict: expected sat")
(declare-const x Int)
(assert (>= x 0))
(assert (< (to_real x) (/ 1.0 2.0)))
(check-sat)
(reset)
(echo "zero coefficients: expected unsat")
(assert (<= 0 (- 1)))
(check-sat)
(reset)
(echo "scope rollback: expected unsat")
(declare-const x Real)
(push)
(assert (<= x 0))
(pop)
(assert (<= x 0))
(assert (>= x 1))
(check-sat)
(reset)
(echo "unconstrained x need not be zero: expected sat")
(declare-const x Real)
(assert (= x 10))
(check-sat)
(reset)
(echo "FP widening 1.0 cannot be 2.0: expected unsat")
(declare-const x (_ FloatingPoint 8 24))
(declare-const y (_ FloatingPoint 11 53))
(assert (= x ((_ to_fp 8 24) RNE 1.0)))
(assert (= y ((_ to_fp 11 53) RNE x)))
(assert (= y ((_ to_fp 11 53) RNE 2.0)))
(check-sat)
(reset)
(echo "polite alternative arrangement: expected sat")
(declare-const x Real)
(declare-const y Real)
(assert (distinct x y))
(check-sat)
(reset)
(echo "model based inconsistent arrangement: expected unsat")
(declare-const x Real)
(declare-const y Real)
(assert (= x 0))
(assert (= y 0))
(assert (distinct x y))
(check-sat)
(reset)
(echo "disjoint identical singleton sets: expected unsat")
(declare-const a (Array Int Bool))
(declare-const b (Array Int Bool))
(assert (= a (store ((as const (Array Int Bool)) false) 1 true)))
(assert (= b (store ((as const (Array Int Bool)) false) 1 true)))
(assert (= ((_ map and) a b) ((as const (Array Int Bool)) false)))
(check-sat)
(reset)
(echo "contradictory Boolean assertions: expected unsat")
(declare-const p Bool)
(assert p)
(assert (not p))
(check-sat)
(reset)
(echo "array disequality: expected sat")
(declare-const a (Array Int Int))
(declare-const b (Array Int Int))
(assert (not (= a b)))
(check-sat)
