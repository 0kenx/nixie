 impl Trail {
+    pub(crate) fn propagation(&mut self) -> PropagationTrail<'_> {
+        // General Trail APIs can contain repeated entries. Reserving merely
+        // num_vars total would assume uniqueness of the existing prefix.
+        // Ordinary BCP can add at most num_vars *new* entries regardless.
+        self.assignments.reserve(self.var_info.len());
