+        let queue = self.assignments.as_mut_ptr();
+        PropagationTrail {
+            assignments: &mut self.assignments,
+            queue,
+            initialized,
+            head: self.prop_head,
+            values: &mut self.values,
+            var_info: &mut self.var_info,
+            prop_head: &mut self.prop_head,
+            level: self.current_level,
+        }
+    }
