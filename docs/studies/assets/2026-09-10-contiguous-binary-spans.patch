@@ -0,0 +1,365 @@
+//! Ordered binary adjacency with one contiguous span per literal.
+//!
+//! Rebuilds allocate exact-size spans. Incremental growth copies a full span
+//! into a larger segment at the pool end; old segments remain inaccessible
+//! until a quiescent rebuild/compaction. Pool reallocation preserves indices.
+use super::{ClauseId, Lit, Var};
+#[allow(unused_imports)]
+use crate::prelude::*;
+
+type Edge = (Lit, ClauseId);
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub(super) struct Span {
+    pub(super) start: u32,
+    pub(super) len: u32,
+    pub(super) capacity: u32,
+    // Preserve the historical removal contract even for duplicate/sentinel IDs:
+    // remove one matching built edge, otherwise all matching appended edges.
+    pub(super) built: u32,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct BinaryImplicationGraph {
+    pub(super) spans: Vec<Span>,
+    pub(super) edges: Vec<Edge>,
+}
+
+impl BinaryImplicationGraph {
+    pub(super) fn new(num_vars: usize) -> Self {
+        Self {
+            spans: vec![Span::default(); num_vars * 2],
+            edges: Vec::new(),
+        }
+    }
+
+    pub(crate) fn edge_accounting(&self) -> (usize, usize) {
+        (
+            self.spans.iter().map(|s| s.len as usize).sum(),
+            self.edges.capacity(),
+        )
+    }
+
+    pub(super) fn resize(&mut self, num_vars: usize) {
+        self.ensure_codes(num_vars * 2);
+    }
+
+    fn ensure_codes(&mut self, n: usize) {
+        if self.spans.len() < n {
+            self.spans.resize(n, Span::default());
+        }
+    }
+
+    pub(super) fn add(&mut self, lit: Lit, implied: Lit, clause_id: ClauseId) {
+        let code = lit.index();
+        self.ensure_codes(code + 1);
+        let mut span = self.spans[code];
+        let Some(new_len) = span.len.checked_add(1) else {
+            panic!("binary span count overflow");
+        };
+        if new_len > span.capacity {
+            // Existing spans never move in place or get reclaimed here: the
+            // scalar HBR path may retain indices into a different trigger.
+            let Ok(start) = u32::try_from(self.edges.len()) else {
+                panic!("binary edge extent overflow");
+            };
+            let capacity = span.capacity.saturating_mul(2).max(4);
+            let Some(end) = start.checked_add(capacity) else {
+                panic!("binary edge extent overflow");
+            };
+            self.edges.resize(end as usize, Self::empty_edge());
+            let old_start = span.start as usize;
+            self.edges
+                .copy_within(old_start..old_start + span.len as usize, start as usize);
+            span.start = start;
+            span.capacity = capacity;
+        }
+        self.edges[span.start as usize + span.len as usize] = (implied, clause_id);
+        span.len = new_len;
+        self.spans[code] = span;
+    }
+
+    #[inline]
+    pub(crate) fn get(&self, lit: Lit) -> &[Edge] {
+        let (start, len) = self.span_of(lit.index());
+        &self.edges[start..start + len]
+    }
+
+    /// Stable indices across appends, including growth of other triggers.
+    /// Compaction/rebuild must not run while a caller uses this snapshot.
+    #[inline]
+    pub(crate) fn span_of(&self, code: usize) -> (usize, usize) {
+        let span = &self.spans[code];
+        (span.start as usize, span.len as usize)
+    }
+
+    #[inline]
+    pub(crate) fn edge_at(&self, at: usize) -> Edge {
+        self.edges[at]
+    }
+
+    #[cfg_attr(not(debug_assertions), allow(dead_code))]
+    pub(crate) fn iter(&self) -> impl Iterator<Item = (Lit, Lit, ClauseId)> + '_ {
+        self.spans.iter().enumerate().flat_map(|(code, span)| {
+            let from = Lit::from_code(code as u32);
+            let start = span.start as usize;
+            self.edges[start..start + span.len as usize]
+                .iter()
+                .map(move |&(to, cid)| (from, to, cid))
+        })
+    }
+
+    pub(super) fn clear(&mut self) {
+        self.spans.fill(Span::default());
+        self.edges.clear();
+    }
+
+    /// Called immediately after a full rebuild. Index-based spans remain
+    /// valid even if shrinking changes the pool's allocation address.
+    pub(super) fn shrink(&mut self) {
+        self.edges.shrink_to_fit();
+    }
+
+    pub(super) fn remove_clause_edges(&mut self, trigger: Lit, clause_id: ClauseId) {
+        let Some(span) = self.spans.get_mut(trigger.index()) else {
+            return;
+        };
+        let start = span.start as usize;
+        let end = start + span.len as usize;
+        let built_end = start + span.built as usize;
+        if let Some(pos) = self.edges[start..built_end]
+            .iter()
+            .position(|&(_, cid)| cid == clause_id)
+        {
+            self.edges.copy_within(start + pos + 1..end, start + pos);
+            span.built -= 1;
+            span.len -= 1;
+        } else {
+            let mut write = built_end;
+            for read in built_end..end {
+                let edge = self.edges[read];
+                if edge.1 != clause_id {
+                    self.edges[write] = edge;
+                    write += 1;
+                }
+            }
+            span.len = (write - start) as u32;
+        }
+    }
+
+    /// Reclaim old segments and dead edges, retaining each logical sequence.
+    /// Relocation puts segments out of literal order, so a separate destination
+    /// pool is necessary: an in-place prefix copy could overwrite unread spans.
+    pub(crate) fn compact_dead(&mut self, dead: &[bool]) {
+        let mut next = Vec::with_capacity(self.edge_accounting().0);
+        for span in &mut self.spans {
+            let start = next.len();
+            let old_start = span.start as usize;
+            let mut built = 0;
+            for (i, &edge) in self.edges[old_start..old_start + span.len as usize]
+                .iter()
+                .enumerate()
+            {
+                if !dead.get(edge.1.index()).copied().unwrap_or(false) {
+                    next.push(edge);
+                    built += u32::from(i < span.built as usize);
+                }
+            }
+            // Live spans are disjoint subsets of the u32-addressed old pool;
+            // filtering cannot increase that extent.
+            let Ok(start32) = u32::try_from(start) else {
+                panic!("binary compacted extent overflow");
+            };
+            let Ok(len) = u32::try_from(next.len() - start) else {
+                panic!("binary compacted span overflow");
+            };
+            *span = Span {
+                start: start32,
+                len,
+                capacity: len,
+                built,
+            };
+        }
+        self.edges = next;
+    }
+
+    pub(super) fn build_reset(&mut self, num_vars: usize) {
+        self.resize(num_vars);
+        self.clear();
+    }
+
+    #[inline]
+    pub(super) fn build_count(&mut self, trigger: Lit) {
+        let span = &mut self.spans[trigger.index()];
+        let Some(count) = span.len.checked_add(1) else {
+            panic!("binary span count overflow");
+        };
+        span.len = count;
+    }
+
+    pub(super) fn build_layout(&mut self) {
+        // Check the complete extent before changing any boundary or cursor.
+        let Some(total) = self
+            .spans
+            .iter()
+            .try_fold(0u32, |acc, span| acc.checked_add(span.len))
+        else {
+            panic!("binary edge extent overflow");
+        };
+        self.edges.clear();
+        self.edges.resize(total as usize, Self::empty_edge());
+        let mut start = 0;
+        for span in &mut self.spans {
+            let capacity = span.len;
+            *span = Span {
+                start,
+                capacity,
+                len: 0,
+                built: 0,
+            };
+            start += capacity;
+        }
+        debug_assert_eq!(start, total);
+    }
+
+    #[inline]
+    pub(super) fn build_edge(&mut self, trigger: Lit, implied: Lit, clause_id: ClauseId) {
+        let span = &mut self.spans[trigger.index()];
+        assert!(
+            span.len == span.built && span.len < span.capacity,
+            "binary count/fill mismatch"
+        );
+        self.edges[span.start as usize + span.len as usize] = (implied, clause_id);
+        span.len += 1;
+        span.built += 1;
+    }
+
+    fn empty_edge() -> Edge {
+        (Lit::pos(Var::new(0)), ClauseId::new(0))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn lit(code: u32) -> Lit {
+        Lit::from_code(code)
+    }
+
+    fn check(graph: &BinaryImplicationGraph, model: &[Vec<Edge>]) {
+        for (code, expected) in model.iter().enumerate() {
+            assert_eq!(graph.get(lit(code as u32)), expected);
+        }
+        assert_eq!(
+            graph.edge_accounting().0,
+            model.iter().map(Vec::len).sum::<usize>()
+        );
+        let mut ranges: Vec<_> = graph
+            .spans
+            .iter()
+            .filter(|s| s.capacity != 0)
+            .map(|s| {
+                assert!(s.built <= s.len && s.len <= s.capacity);
+                assert!(s.start as usize + s.capacity as usize <= graph.edges.len());
+                (s.start, s.start + s.capacity)
+            })
+            .collect();
+        ranges.sort_unstable();
+        assert!(ranges.windows(2).all(|pair| pair[0].1 <= pair[1].0));
+    }
+
+    #[test]
+    fn contiguous_spans_growth_compaction_clone_and_reset() {
+        let mut graph = BinaryImplicationGraph::new(4);
+        let mut model = vec![Vec::new(); 8];
+        for code in 0..8 {
+            graph.build_count(lit(code));
+        }
+        graph.build_layout();
+        for code in 0..8 {
+            let edge = (lit(code ^ 1), ClauseId::new(code));
+            graph.build_edge(lit(code), edge.0, edge.1);
+            model[code as usize].push(edge);
+        }
+        // Reverse-key relocations make physical and logical order disagree.
+        for id in 8..104 {
+            let code = 7 - id % 8;
+            let edge = (lit(code ^ 1), ClauseId::new(id));
+            graph.add(lit(code), edge.0, edge.1);
+            model[code as usize].push(edge);
+            check(&graph, &model);
+            if id % 11 == 0 {
+                let old = model[code as usize][0].1;
+                graph.remove_clause_edges(lit(code), old);
+                model[code as usize].remove(0);
+                check(&graph, &model);
+            }
+            if id % 23 == 0 {
+                let dead: Vec<_> = (0..=id).map(|n| n % 3 == 0).collect();
+                graph.compact_dead(&dead);
+                for list in &mut model {
+                    list.retain(|edge| !dead[edge.1.index()]);
+                }
+                check(&graph, &model);
+            }
+        }
+        let mut cloned = graph.clone();
+        graph.clear();
+        assert!(graph.iter().next().is_none());
+        check(&cloned, &model);
+        cloned.resize(17);
+        model.resize(34, Vec::new());
+        check(&cloned, &model);
+        cloned.add(lit(33), lit(32), ClauseId::new(200));
+        model[33].push((lit(32), ClauseId::new(200)));
+        check(&cloned, &model);
+        cloned.compact_dead(&[]);
+        cloned.shrink();
+        check(&cloned, &model);
+        cloned.build_reset(17);
+        cloned.build_count(lit(32));
+        cloned.build_layout();
+        cloned.build_edge(lit(32), lit(33), ClauseId::new(201));
+        model.iter_mut().for_each(Vec::clear);
+        model[32].push((lit(33), ClauseId::new(201)));
+        check(&cloned, &model);
+    }
+
+    #[test]
+    fn contiguous_spans_preserve_duplicate_origin_removal() {
+        let mut graph = BinaryImplicationGraph::new(2);
+        for _ in 0..2 {
+            graph.build_count(lit(0));
+        }
+        graph.build_layout();
+        let id = ClauseId::new(u32::MAX);
+        graph.build_edge(lit(0), lit(1), id);
+        graph.build_edge(lit(0), lit(2), id);
+        graph.add(lit(0), lit(3), id);
+        graph.add(lit(0), lit(0), id);
+        graph.compact_dead(&[]);
+        graph.remove_clause_edges(lit(0), id);
+        assert_eq!(
+            graph.get(lit(0)),
+            [(lit(2), id), (lit(3), id), (lit(0), id)]
+        );
+        graph.remove_clause_edges(lit(0), id);
+        assert_eq!(graph.get(lit(0)), [(lit(3), id), (lit(0), id)]);
+        graph.remove_clause_edges(lit(0), id);
+        assert!(graph.get(lit(0)).is_empty());
+    }
+
+    #[test]
+    fn contiguous_spans_other_trigger_growth_preserves_snapshot() {
+        let mut graph = BinaryImplicationGraph::new(2);
+        graph.add(lit(0), lit(1), ClauseId::new(0));
+        let (start, len) = graph.span_of(0);
+        for id in 1..65 {
+            graph.add(lit(2), lit(3), ClauseId::new(id));
+        }
+        assert_eq!(len, 1);
+        assert_eq!(graph.edge_at(start), (lit(1), ClauseId::new(0)));
+        assert_eq!(graph.span_of(0), (start, len));
+    }
+}
