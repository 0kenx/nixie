+/// Exclusive, fixed-domain trail borrow for an ordinary BCP fixpoint.
+/// The queue is reserved before borrowing; only local initialized-length and
+/// head cursors change during the pass. Ending the view publishes both cursors.
+/// Creating variables, changing levels and backtracking require ending this
+/// borrow first. No pointer is shared with another solver or worker.
+pub(crate) struct PropagationTrail<'a> {
+    assignments: &'a mut Vec<Lit>,
+    queue: *mut Lit,
+    initialized: usize,
+    head: usize,
+    values: &'a mut [i8],
+    var_info: &'a mut [VarInfo],
+    prop_head: &'a mut usize,
+    level: u32,
+}
+
+impl PropagationTrail<'_> {
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(crate) fn next(&mut self) -> Option<Lit> {
+        if self.head >= self.initialized {
+            return None;
+        }
+        // SAFETY: the original prefix and every appended entry below
+        // initialized contain a Lit. The exclusive queue borrow prevents
+        // reallocation or element references while this pointer is used.
+        let lit = unsafe { self.queue.add(self.head).read() };
+        self.head += 1;
+        Some(lit)
+    }
+
+    /// Same solver-literal domain contract as `Trail::lit_val_hot`. Unlike
+    /// the general trail, this view cannot grow or replace the value array.
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(crate) fn value(&self, lit: Lit) -> i8 {
+        debug_assert!(lit.index() < self.values.len());
+        // SAFETY: Solver sizes the values for every variable before attaching
+        // a watch/edge or assigning it. This borrow prevents domain changes.
+        unsafe { *self.values.get_unchecked(lit.index()) }
+    }
+
+    /// Append an ordinary propagation without queue growth or publication.
+    ///
+    /// # Safety
+    /// `lit` must be in the borrowed variable domain and currently undefined.
+    /// No backtrack/unassignment is possible through this view, so each such
+    /// assignment consumes a different variable and there are at most domain
+    /// size appends. Entry reserved that many slots beyond the original length.
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(crate) unsafe fn assign_undefined(&mut self, lit: Lit, reason: ClauseId) {
+        let code = lit.index();
+        let idx = lit.var().index();
+        debug_assert!(idx < self.var_info.len());
+        debug_assert!(code < self.values.len() && (code ^ 1) < self.values.len());
+        debug_assert_eq!(self.values[code], 0);
+        debug_assert!(self.initialized < self.assignments.capacity());
+        // SAFETY: the caller supplies an in-domain literal. Both signs of
+        // every variable are allocated together; this exclusive view cannot
+        // resize either array. These are disjoint byte stores and a metadata
+        // store into the valid variable slot, without live element aliases.
+        unsafe {
+            *self.values.get_unchecked_mut(code) = 1;
+            *self.values.get_unchecked_mut(code ^ 1) = -1;
+            *self.var_info.get_unchecked_mut(idx) = VarInfo {
+                value: if lit.is_pos() {
+                    LBool::True
+                } else {
+                    LBool::False
+                },
+                level: self.level,
+                reason: Reason::Propagation(reason),
+                trail_idx: self.initialized as u32,
+            };
+        }
+        // SAFETY: the undefined-variable contract bounds total appends by
+        // the additional domain-sized reservation. This slot is in the fixed
+        // allocation and no element reference aliases it. Publish locally
+        // only after its initialized Lit has been written.
+        unsafe { self.queue.add(self.initialized).write(lit) };
+        self.initialized += 1;
+    }
+}
+
+impl Drop for PropagationTrail<'_> {
+    #[allow(unsafe_code)]
+    #[inline]
+    fn drop(&mut self) {
+        // SAFETY: every entry below initialized is initialized, within the
+        // reserved allocation. No raw queue access occurs after this commit.
+        // Lit is Copy and has no destructor; unwinding cannot expose the
+        // uninitialized capacity beyond this prefix.
+        unsafe { self.assignments.set_len(self.initialized) };
+        *self.prop_head = self.head;
+    }
+}
