 use super::*;
 use nixie_proof::lrat_check::check_lrat_proof;
 
+#[cfg(feature = "bcp-groups")]
+#[test]
+fn product_provenance_records_only_inserted_outputs_in_both_proof_paths() {
+    for proof in [false, true] {
+        for reverse in [false, true] {
+            let mut s = Solver::new();
+            s.ensure_vars(5);
+            s.enable_watch_group_stats(std::num::NonZeroU64::MIN);
+            if proof {
+                let _ = s.enable_lrat_transcript();
+            }
+            let [x, a, b, c, d] = std::array::from_fn(|i| Lit::from_code(i as u32 * 2));
+            let pivot = if reverse { !x } else { x };
+            s.add_clause([pivot, a, b]);
+            s.add_clause([!pivot, c, d]);
+            let ids: Vec<_> = s.clauses.iter_ids().collect();
+            assert_eq!(ids.len(), 2);
+            let collected = vec![(SmallVec::from_slice(&[a, b, c, d]), ids[0], ids[1])];
+            let mut ctx = Eliminator::new(5, &s.trail);
+            s.elim_add_resolvents(&mut ctx, &collected);
+            assert_eq!(ctx.backward.len(), 1);
+            let output = ctx.backward[0];
+            // Repeating the proposed insertion under a satisfying context
+            // does not create an output or record a fictitious birth.
+            s.trail.assign_unit_fact(a);
+            let mut ctx = Eliminator::new(5, &s.trail);
+            s.elim_add_resolvents(&mut ctx, &collected);
+            assert!(ctx.backward.is_empty());
+            let mut out = Vec::new();
+            s.write_watch_group_report(&mut out).expect("report");
+            let report: serde_json::Value = serde_json::from_slice(&out).expect("JSON");
+            assert_eq!(report["products"]["batches"], 2);
+            assert_eq!(
+                report["products"]["births"],
+                serde_json::json!([[output.0, 0, ids[0].0, ids[1].0, 4]])
+            );
+        }
+    }
+}
