+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::watch_groups::Entry;
+
+    #[test]
+    fn births_and_prefixes_preserve_ids_multiplicity_and_empty_tail() {
+        let mut census = ProductCensus::default();
+        let family = census.begin_batch();
+        census.record(
+            family,
+            ClauseId::new(12),
+            ClauseId::new(3),
+            ClauseId::new(8),
+            4,
+        );
+        let sample = Sample {
+            trigger: 2,
+            ordinal: 4096,
+            conflict_bin: 3,
+            entries: [12, 12, 99]
+                .map(|clause| Entry {
+                    clause,
+                    blocker: 0,
+                    true_at_entry: false,
+                })
+                .into(),
+            hits: vec![true, false],
+        };
+        census.observe(&sample);
+        let mut out = Vec::new();
+        census.write_json(&mut out).expect("report");
+        let report: serde_json::Value = serde_json::from_slice(&out).expect("JSON");
+        assert_eq!(report["births"], serde_json::json!([[12, 0, 3, 8, 4]]));
+        assert_eq!(
+            report["lists"],
+            serde_json::json!([[4096, 3, [[12, 1], [12, 0]]]])
+        );
+        assert_eq!(report["trace_entries"], 2);
+    }
+
+    #[test]
+    fn limits_and_writer_errors_are_explicit() {
+        let mut census = ProductCensus {
+            batches: MAX_BATCHES,
+            ..Default::default()
+        };
+        let family = census.begin_batch();
+        assert_eq!(family, None);
+        census.record(
+            family,
+            ClauseId::new(0),
+            ClauseId::new(1),
+            ClauseId::new(2),
+            2,
+        );
+        census.record(
+            Some(0),
+            ClauseId::new(MAX_ORIGIN_SLOTS as u32),
+            ClauseId::new(1),
+            ClauseId::new(2),
+            2,
+        );
+        census.trace_entries = MAX_TRACE_ENTRIES;
+        census.observe(&Sample {
+            trigger: 2,
+            ordinal: 0,
+            conflict_bin: 0,
+            entries: vec![Entry {
+                clause: 0,
+                blocker: 0,
+                true_at_entry: false,
+            }],
+            hits: vec![false],
+        });
+        assert_eq!(
+            (
+                census.omitted_batches,
+                census.omitted_outputs,
+                census.omitted_lists,
+                census.omitted_entries
+            ),
+            (1, 2, 1, 1)
+        );
+        let mut out = [0u8; 3];
+        assert!(census.write_json(&mut out[..]).is_err());
+    }
+}
