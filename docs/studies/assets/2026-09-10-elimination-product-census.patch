+//! Passive birth provenance and sampled visited prefixes. These records are
+//! neither complete products nor propagation certificates. Shrink/deletion
+//! deliberately retain birth membership, providing an optimistic coverage
+//! screen for direct elimination outputs. Never consulted by search.
+
+use super::Sample;
+use crate::ClauseId;
+use std::io::{self, Write};
+
+const MAX_ORIGIN_SLOTS: usize = 1_000_000;
+const MAX_BATCHES: u32 = 100_000;
+const MAX_TRACE_ENTRIES: usize = 4_000_000;
+const MAX_TRACE_LISTS: usize = 200_000;
+
+#[derive(Clone, Copy, Debug)]
+struct Origin {
+    family: u32,
+    left: u32,
+    right: u32,
+    width: usize,
+}
+
+#[derive(Debug)]
+struct TraceList {
+    ordinal: u64,
+    conflict_bin: usize,
+    // The hit flag is encoded as 0/1 so Debug prints valid nested JSON arrays.
+    entries: Vec<[u32; 2]>,
+}
+
+#[derive(Debug, Default)]
+pub(super) struct ProductCensus {
+    origins: Vec<Option<Origin>>,
+    batches: u32,
+    omitted_batches: u64,
+    omitted_outputs: u64,
+    omitted_lists: u64,
+    omitted_entries: u64,
+    trace_entries: usize,
+    lists: Vec<TraceList>,
+}
+
+impl ProductCensus {
+    pub(super) fn begin_batch(&mut self) -> Option<u32> {
+        if self.batches == MAX_BATCHES {
+            self.omitted_batches += 1;
+            return None;
+        }
+        let family = self.batches;
+        self.batches += 1;
+        Some(family)
+    }
+
+    pub(super) fn record(
+        &mut self,
+        family: Option<u32>,
+        output: ClauseId,
+        left: ClauseId,
+        right: ClauseId,
+        width: usize,
+    ) {
+        let Some(family) = family else {
+            self.omitted_outputs += 1;
+            return;
+        };
+        assert!(family < self.batches, "unregistered product batch");
+        if output.index() >= MAX_ORIGIN_SLOTS {
+            self.omitted_outputs += 1;
+            return;
+        }
+        self.origins
+            .resize(self.origins.len().max(output.index() + 1), None);
+        let slot = &mut self.origins[output.index()];
+        assert!(slot.is_none(), "clause identity reused in product census");
+        *slot = Some(Origin {
+            family,
+            left: left.0,
+            right: right.0,
+            width,
+        });
+    }
+
+    pub(super) fn observe(&mut self, sample: &Sample) {
+        assert!(sample.hits.len() <= sample.entries.len());
+        let n = sample.hits.len();
+        if self.lists.len() == MAX_TRACE_LISTS || n > MAX_TRACE_ENTRIES - self.trace_entries {
+            self.omitted_lists += 1;
+            self.omitted_entries += n as u64;
+            return;
+        }
+        self.trace_entries += n;
+        self.lists.push(TraceList {
+            ordinal: sample.ordinal,
+            conflict_bin: sample.conflict_bin,
+            entries: sample
+                .entries
+                .iter()
+                .zip(&sample.hits)
+                .map(|(entry, &hit)| [entry.clause, u32::from(hit)])
+                .collect(),
+        });
+    }
+
+    pub(super) fn write_json(&self, mut out: impl Write) -> io::Result<()> {
+        write!(
+            out,
+            "{{\"schema\":\"nixie-elimination-products/1\",\"origin_slot_limit\":{MAX_ORIGIN_SLOTS},\"batch_limit\":{MAX_BATCHES},\"trace_entry_limit\":{MAX_TRACE_ENTRIES},\"trace_list_limit\":{MAX_TRACE_LISTS},\"batches\":{},\"omitted_batches\":{},\"omitted_outputs\":{},\"omitted_lists\":{},\"omitted_entries\":{},\"trace_entries\":{},\"births\":[",
+            self.batches,
+            self.omitted_batches,
+            self.omitted_outputs,
+            self.omitted_lists,
+            self.omitted_entries,
+            self.trace_entries
+        )?;
+        let mut comma = "";
+        for (id, origin) in self.origins.iter().enumerate() {
+            let Some(origin) = origin else { continue };
+            write!(
+                out,
+                "{comma}[{id},{},{},{},{}]",
+                origin.family, origin.left, origin.right, origin.width
+            )?;
+            comma = ",";
+        }
+        write!(out, "],\"lists\":[")?;
+        comma = "";
+        for list in &self.lists {
+            write!(
+                out,
+                "{comma}[{},{},{:?}]",
+                list.ordinal, list.conflict_bin, list.entries
+            )?;
+            comma = ",";
+        }
+        write!(out, "]}}")
+    }
+}
