+        solver.push();
+        solver.pop();
+        assert_eq!(births(&solver), before);
+        solver.reset();
+        assert_eq!(births(&solver), serde_json::json!([]));
+        record(&mut solver);
+        assert_eq!(births(&solver), before);
+    }
