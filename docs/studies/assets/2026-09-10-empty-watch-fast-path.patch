diff --git a/nixie-sat/src/solver/watch_kernel_tests.rs b/nixie-sat/src/solver/watch_kernel_tests.rs
index 81b45772..0b2aacff 100644
--- a/nixie-sat/src/solver/watch_kernel_tests.rs
+++ b/nixie-sat/src/solver/watch_kernel_tests.rs
@@ -1,6 +1,60 @@
 use super::*;
 use nixie_proof::lrat_check::check_lrat_proof;
 
+#[test]
+fn empty_long_lists_preserve_binary_work_ticks_budgets_and_requeue() {
+    for stable in [false, true] {
+        for proof in [false, true] {
+            for limit in [None, Some(0), Some(1), Some(3)] {
+                for conflict in [false, true] {
+                    let clauses = vec![vec![-1, 2], vec![-2, 3], vec![-3, 4]];
+                    let (mut a, mut b, pa, pb) = pair(5, &clauses, proof);
+                    let trigger = Lit::from_code(0);
+                    for s in [&mut a, &mut b] {
+                        s.stable = stable;
+                        s.ticks_stable = u64::MAX - 2;
+                        s.ticks_focused = u64::MAX - 2;
+                        // Exercise an allocated empty list and phantom-only
+                        // charge crossing a cache-line boundary.
+                        s.watches.get_mut(trigger).reserve(17);
+                        for _ in 0..17 {
+                            s.watches.phantom_bump(trigger);
+                        }
+                        s.trail.new_decision_level();
+                        if conflict {
+                            s.trail.assign_decision(Lit::from_code(7));
+                        }
+                        s.trail.assign_decision(trigger);
+                        s.propagate_step_limit = limit;
+                    }
+                    let capacity = a.watches.get_mut(trigger).capacity();
+                    assert_eq!(a.propagate(), b.propagate());
+                    assert_state(&a, &b);
+                    assert_eq!(a.watches.get_mut(trigger).capacity(), capacity);
+                    for s in [&mut a, &mut b] {
+                        s.trail.backtrack_to(0);
+                        s.propagate_step_limit = None;
+                        s.propagate_aborted = false;
+                        // A root binary chain exercises LRAT unit flushing.
+                        s.add_clause([trigger]);
+                    }
+                    assert_eq!(a.propagate(), b.propagate());
+                    assert_state(&a, &b);
+                    assert_eq!(a.no_conflict_until, a.trail.size());
+                    for var in 0..4 {
+                        assert!(a.trail.lit_val(Lit::from_code(var * 2)) > 0);
+                    }
+                    if let (Some(pa), Some(pb)) = (pa, pb) {
+                        a.flush_proof();
+                        b.flush_proof();
+                        assert_eq!(pa.snapshot().expect("proof"), pb.snapshot().expect("proof"));
+                    }
+                }
+            }
+        }
+    }
+}
