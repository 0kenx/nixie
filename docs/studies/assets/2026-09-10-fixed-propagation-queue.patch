+#[test]
+fn complete_engine_gates_mutating_and_bounded_modes() {
+    let mut s = Solver::new();
+    assert!(s.use_complete_engine());
+    s.propagate_step_limit = Some(0);
+    assert!(!s.use_complete_engine());
+    s.propagate_step_limit = None;
+    s.config.enable_lazy_hyper_binary = true;
+    assert!(!s.use_complete_engine());
+    s.config.enable_lazy_hyper_binary = false;
+    let _proof = s.enable_lrat_transcript();
+    assert!(!s.use_complete_engine());
+}
+
+#[test]
+fn fixed_queue_binary_span_conflict_preserves_unvisited_overflow() {
+    for primary_conflict in [false, true] {
+        let mut a = Solver::new();
+        let mut b = Solver::new();
+        b.propagate_legacy_oracle = true;
+        let [trigger, bad, before, after] = std::array::from_fn(|i| Lit::from_code(2 * i as u32));
+        for s in [&mut a, &mut b] {
+            s.ensure_vars(4);
+            let main = if primary_conflict { bad } else { before };
+            let id = s.clauses.add_original([!trigger, main]);
+            s.attach_watchers(id, !trigger, main);
+            s.rebuild_watches_and_binary_graph();
+            let extra = if primary_conflict { after } else { bad };
+            for implied in [extra, after] {
+                let id = s.clauses.add_original([!trigger, implied]);
+                s.attach_watchers(id, !trigger, implied);
+            }
+            s.trail.new_decision_level();
+            s.trail.assign_decision(!bad);
+            while s.trail.next_to_propagate().is_some() {}
+            s.trail.assign_decision(trigger);
+        }
+        assert!(a.propagate().is_some());
+        assert!(b.propagate().is_some());
+        assert_state(&a, &b);
+        assert_eq!(a.trail.lit_val(after), 0);
+        assert_eq!(a.trail.lit_val(before), i8::from(!primary_conflict));
+        assert_eq!(a.trail.propagation_head(), 1, "trigger requeued");
+        assert_eq!(a.stats.propagations, 1);
+    }
+}
+
+fn complete_engine_owner_pair() -> (Solver, Solver) {
+    let mut a = Solver::new();
+    let mut b = Solver::new();
+    b.propagate_legacy_oracle = true;
+    for s in [&mut a, &mut b] {
+        s.ensure_vars(40);
+        for i in 1..39 {
+            let from = Lit::from_code(2 * i);
+            let to = Lit::from_code(2 * (i + 1));
+            let mut lits = vec![!from, to];
+            if i % 2 == 0 {
+                lits.push(Lit::from_code(1));
+            }
+            let id = s.clauses.add_original(lits.clone());
+            s.attach_watchers(id, lits[0], lits[1]);
+        }
+        // Freeze the primary binary spans before moving the owner.
+        s.rebuild_watches_and_binary_graph();
+    }
+    (a, b)
+}
+
+fn exercise_complete_engine_owner_pair((mut a, mut b): (Solver, Solver)) {
+    for s in [&mut a, &mut b] {
+        // Resize after the move, retaining primary edges. New binaries land
+        // in overflow; the long clauses exercise destination-buffer growth.
+        s.ensure_vars(80);
+        for i in 39..79 {
+            let from = Lit::from_code(2 * i);
+            let to = Lit::from_code(2 * (i + 1));
+            let mut lits = vec![!from, to];
+            if i % 2 == 0 {
+                lits.push(Lit::from_code(1));
+            }
+            let id = s.clauses.add_original(lits.clone());
+            s.attach_watchers(id, lits[0], lits[1]);
+        }
+        // Leave one deleted slot for the arena compactor to relocate.
+        let id = s
+            .clauses
+            .add_original([Lit::from_code(4), Lit::from_code(6), Lit::from_code(8)]);
+        s.attach_watchers(id, Lit::from_code(4), Lit::from_code(6));
+        s.clauses.mark_deleted_raw(id);
+        assert!(s.clauses.compact_arena_forced(&mut s.watches));
+    }
+    for stable in [false, true] {
+        for s in [&mut a, &mut b] {
+            s.stable = stable;
+            s.trail.new_decision_level();
+            s.trail.assign_decision(Lit::from_code(0));
+            s.trail.assign_decision(Lit::from_code(2));
+        }
+        assert_eq!(a.propagate(), None);
+        assert_eq!(b.propagate(), None);
+        assert_eq!(a.trail.size(), 80);
+        assert_state(&a, &b);
+        for s in [&mut a, &mut b] {
+            s.trail.backtrack_to(0);
+            s.trail.new_decision_level();
+            s.trail.assign_decision(Lit::from_code(0));
+            s.trail.assign_decision(Lit::from_code(159));
+            s.trail.assign_decision(Lit::from_code(2));
+        }
+        assert!(a.propagate().is_some());
+        assert!(b.propagate().is_some());
+        assert_state(&a, &b);
+        a.trail.backtrack_to(0);
+        b.trail.backtrack_to(0);
+    }
+}
+
+#[test]
+fn complete_engine_moved_owner_growth_compaction_and_requeue() {
+    exercise_complete_engine_owner_pair(complete_engine_owner_pair());
+}
