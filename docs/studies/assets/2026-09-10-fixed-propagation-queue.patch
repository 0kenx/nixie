+#[cfg(feature = "std")]
+#[test]
+fn complete_engine_prebuilt_owners_move_to_rayon() {
+    use rayon::prelude::*;
+    let pairs: Vec<_> = (0..8).map(|_| complete_engine_owner_pair()).collect();
+    let pool = rayon::ThreadPoolBuilder::new()
