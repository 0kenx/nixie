+//! One complete long-watch list under fixed-domain assignment/arena borrows.
+//! Both compaction phases retain a narrow call boundary; no BIG state or outer
+//! propagation-head cursor is live inside this kernel. Units never yield.
+use super::{ClauseId, Lit, Watcher};
+#[allow(unused_imports)]
+use crate::prelude::*;
+
+#[derive(Default)]
+pub(super) struct Cursor {
+    #[cfg(feature = "bcp-work")]
+    pub(super) work: super::super::PropagationWork,
+    pub(super) read: usize,
+    pub(super) write: usize,
+}
+
+impl Cursor {
+    /// The prefix transfers to the suffix exactly once, at the first removal.
+    /// The suffix never calls either phase, so call depth is bounded by two,
+    /// independently of the input or the number of removals. Const specialization
+    /// removes the compaction-state test from every kept entry in both loops.
+    #[inline(never)]
+    pub(super) fn scan<const COMPACT: bool>(
+        &mut self,
+        watches: &mut [Watcher],
+        false_lit: Lit,
+        trail: &mut crate::trail::AssignmentTrail<'_>,
+        clauses: &mut crate::memory::PropagationArena<'_>,
+        destinations: &mut [Vec<Watcher>],
+    ) -> Option<ClauseId> {
+        debug_assert_eq!(self.write < self.read, COMPACT);
+        let mut write = self.write;
+        for read in self.read..watches.len() {
+            let watcher = watches[read];
+            #[cfg(feature = "bcp-work")]
+            {
+                self.work.long_visits += 1;
+            }
+            if trail.value(watcher.blocker) > 0 {
+                if COMPACT {
+                    watches[write] = watcher;
+                    write += 1;
+                }
+                continue;
+            }
+            #[cfg(feature = "bcp-work")]
+            {
+                self.work.clause_reads += 1;
+            }
+            let Some(mut live) = clauses.live_clause(watcher.r) else {
+                #[cfg(feature = "bcp-work")]
+                {
+                    self.work.deleted += 1;
+                }
+                if COMPACT {
+                    continue;
+                }
+                self.read = read + 1;
+                self.write = read;
+                return self.scan::<true>(watches, false_lit, trail, clauses, destinations);
+            };
+            let clause = live.lits();
+            debug_assert!(clause[0] == false_lit || clause[1] == false_lit);
+            let first = Lit::from_code(clause[0].code() ^ clause[1].code() ^ false_lit.code());
+            // Even satisfied exits keep the original eager normalization:
+            // subsequent inprocessing observes literal order.
+            clause[0] = first;
+            clause[1] = false_lit;
+            if trail.value(first) > 0 {
+                #[cfg(feature = "bcp-work")]
+                {
+                    self.work.first_satisfied += 1;
+                }
+                let kept = if COMPACT { write } else { read };
+                if COMPACT {
+                    watches[kept] = watcher;
+                    write += 1;
+                }
+                watches[kept].blocker = first;
+                continue;
+            }
+            let mut found = false;
+            for j in 2..clause.len() {
+                #[cfg(feature = "bcp-work")]
+                {
+                    self.work.tail_probes += 1;
+                }
+                let literal = clause[j];
+                let value = trail.value(literal);
+                if value > 0 {
+                    #[cfg(feature = "bcp-work")]
+                    {
+                        self.work.tail_satisfied += 1;
+                    }
+                    let kept = if COMPACT { write } else { read };
+                    if COMPACT {
+                        watches[kept] = watcher;
+                        write += 1;
+                    }
+                    watches[kept].blocker = literal;
+                    found = true;
+                    break;
+                }
+                if value == 0 {
+                    clause.swap(1, j);
+                    #[cfg(feature = "bcp-work")]
+                    {
+                        self.work.watch_moves += 1;
+                    }
+                    destinations[clause[1].negate().index()].push(Watcher {
+                        blocker: first,
+                        ..watcher
+                    });
+                    if !COMPACT {
+                        self.read = read + 1;
+                        self.write = read;
+                        return self.scan::<true>(watches, false_lit, trail, clauses, destinations);
+                    }
+                    found = true;
+                    break;
+                }
+            }
+            if found {
+                continue;
+            }
+            let kept = if COMPACT { write } else { read };
+            if COMPACT {
+                watches[kept] = watcher;
+            }
+            watches[kept].blocker = first;
+            let next_write = kept + 1;
+            if trail.value(first) < 0 {
+                #[cfg(feature = "bcp-work")]
+                {
+                    self.work.long_conflicts += 1;
+                }
+                // Preserve the unvisited tail without examining its blockers.
+                // In the prefix it is already in its final position.
+                if COMPACT {
+                    watches.copy_within(read + 1.., next_write);
+                }
+                self.read = watches.len();
+                self.write = next_write + watches.len() - read - 1;
+                return Some(live.reason());
+            }
+            // SAFETY: first is an in-domain clause literal. Its true exit
+            // precedes the tail scan and its false exit is above. No assignment
+            // occurred between these checks, so it is still undefined. The
+            // exclusive view prevents resize, unassignment and queue growth.
+            #[allow(unsafe_code)]
+            unsafe {
+                trail.assign_undefined(first, live.reason())
+            };
+            #[cfg(feature = "bcp-work")]
+            {
+                self.work.long_assignments += 1;
+            }
+            if COMPACT {
+                write = next_write;
+            }
+        }
+        self.read = watches.len();
+        self.write = if COMPACT { write } else { watches.len() };
+        None
+    }
+}
