+//! One truth bit per literal; a variable's two bits are mutually exclusive.
+//! Padding is always zero. Growth exposes only previously zero padding/words.
+#[allow(unused_imports)]
+use crate::prelude::*;
+
+#[derive(Debug)]
+pub(super) struct PackedTruth {
+    words: Vec<u64>,
+    literals: usize,
+}
+
+#[inline]
+pub(super) fn decode(word: u64, code: usize) -> i8 {
+    ((word >> (code & 63)) & 1) as i8 - ((word >> ((code ^ 1) & 63)) & 1) as i8
+}
+
+#[inline]
+pub(super) fn true_bit(word: u64, code: usize) -> bool {
+    word & (1u64 << (code & 63)) != 0
+}
+
+#[inline]
+pub(super) fn assign_word(word: &mut u64, code: usize) {
+    *word = (*word & !(3u64 << (code & 62))) | (1u64 << (code & 63));
+}
+
+impl PackedTruth {
+    pub(super) fn new(literals: usize) -> Self {
+        assert!(
+            literals.is_multiple_of(2),
+            "truth domain must contain both signs"
+        );
+        Self {
+            words: vec![0; literals.div_ceil(64)],
+            literals,
+        }
+    }
+
+    #[inline]
+    pub(super) fn len(&self) -> usize {
+        self.literals
+    }
+
+    pub(super) fn grow(&mut self, literals: usize) {
+        assert!(
+            literals.is_multiple_of(2),
+            "truth domain must contain both signs"
+        );
+        if literals > self.literals {
+            self.words.resize(literals.div_ceil(64), 0);
+            self.literals = literals;
+        }
+    }
+
+    #[inline]
+    pub(super) fn get(&self, code: usize) -> Option<i8> {
+        (code < self.literals).then(|| decode(self.words[code >> 6], code))
+    }
+
+    #[inline]
+    pub(super) fn value(&self, code: usize) -> i8 {
+        assert!(code < self.literals, "literal outside truth domain");
+        decode(self.words[code >> 6], code)
+    }
+
+    /// Caller guarantees a literal in this table's domain.
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(super) unsafe fn value_hot(&self, code: usize) -> i8 {
+        debug_assert!(code < self.literals);
+        // SAFETY: domain membership implies the word is initialized/in bounds.
+        decode(unsafe { *self.words.get_unchecked(code >> 6) }, code)
+    }
+
+    /// Caller guarantees a literal in this table's domain.
+    #[allow(unsafe_code)]
+    #[inline]
+    pub(super) unsafe fn is_true_hot(&self, code: usize) -> bool {
+        debug_assert!(code < self.literals);
+        // SAFETY: domain membership implies the word is initialized/in bounds.
+        true_bit(unsafe { *self.words.get_unchecked(code >> 6) }, code)
+    }
+
+    #[inline]
+    pub(super) fn assign(&mut self, code: usize) {
+        assert!(code < self.literals, "literal outside truth domain");
+        assign_word(&mut self.words[code >> 6], code);
+    }
+
+    #[inline]
+    pub(super) fn clear(&mut self, code: usize) {
+        assert!(code < self.literals, "literal outside truth domain");
+        self.words[code >> 6] &= !(3u64 << (code & 62));
+    }
+
+    pub(super) fn words_mut(&mut self) -> &mut [u64] {
+        &mut self.words
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn check(table: &PackedTruth, oracle: &[i8]) {
+        assert_eq!(table.len(), oracle.len());
+        for (code, &expected) in oracle.iter().enumerate() {
+            assert_eq!(table.get(code), Some(expected));
+            assert_eq!(table.value(code), expected);
+            // SAFETY: iteration stays in the independently sized domain.
+            #[allow(unsafe_code)]
+            unsafe {
+                assert_eq!(table.value_hot(code), expected);
+                assert_eq!(table.is_true_hot(code), expected > 0);
+            }
+        }
+        assert_eq!(table.get(oracle.len()), None);
+        assert_eq!(table.get(usize::MAX), None);
+        for code in (0..table.words.len() * 64).step_by(2) {
+            let pair = (table.words[code >> 6] >> (code & 63)) & 3;
+            assert_ne!(pair, 3);
+            if code >= table.len() {
+                assert_eq!(pair, 0);
+            }
+        }
+    }
