+    fn packed_truth_rejects_padding_and_incomplete_domains() {
+        assert!(std::panic::catch_unwind(|| PackedTruth::new(3)).is_err());
+        assert!(std::panic::catch_unwind(|| PackedTruth::new(2).assign(2)).is_err());
+        assert!(std::panic::catch_unwind(|| PackedTruth::new(2).clear(3)).is_err());
+        assert!(std::panic::catch_unwind(|| PackedTruth::new(2).value(2)).is_err());
+    }
+
+    #[test]
+    fn packed_truth_word_boundary_borrows() {
+        let mut table = PackedTruth::new(64);
+        table.assign(63);
+        table.grow(130);
+        let mut oracle = vec![0; 130];
+        oracle[63] = 1;
+        oracle[62] = -1;
+        for code in [0, 1, 62, 63, 64, 65, 126, 127, 128, 129] {
+            // The fixed propagation view uses this same complete word borrow.
+            assign_word(&mut table.words_mut()[code >> 6], code);
+            oracle[code] = 1;
+            oracle[code ^ 1] = -1;
+            check(&table, &oracle);
+            table.clear(code ^ 1);
+            oracle[code] = 0;
+            oracle[code ^ 1] = 0;
+            check(&table, &oracle);
+        }
+    }
+}
