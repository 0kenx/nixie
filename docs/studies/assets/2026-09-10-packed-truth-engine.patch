+            oracle.resize(size, 0);
+            check(&table, &oracle);
+            for code in 0..size {
+                table.assign(code);
+                oracle[code] = 1;
+                oracle[code ^ 1] = -1;
+                check(&table, &oracle);
+            }
+            for code in (0..size).rev().step_by(2) {
+                table.clear(code);
+                oracle[code] = 0;
+                oracle[code ^ 1] = 0;
+                check(&table, &oracle);
+            }
+            // Leave live pairs across the next within-word/whole-word growth.
+            table.assign(size - 1);
+            oracle[size - 1] = 1;
+            oracle[size - 2] = -1;
+        }
+        let before = table.words.clone();
+        table.grow(2);
+        assert_eq!(table.words, before);
+        check(&table, &oracle);
+    }
