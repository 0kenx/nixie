+//! Ordinary BCP to a complete fixpoint under exclusive fixed-domain borrows.
+//! No unit yield, Solver callback, variable creation or arena relocation.
+use super::{BinaryImplicationGraph, ClauseDatabase, ClauseId, Lit, Watcher};
+use crate::memory::PropagationArena;
+#[allow(unused_imports)]
+use crate::prelude::*;
+use crate::trail::PropagationTrail;
+
+#[inline(never)]
+pub(super) fn propagate(
+    mut trail: PropagationTrail<'_>,
+    binary: &BinaryImplicationGraph,
+    clauses: &mut ClauseDatabase,
+    destinations: &mut [Vec<Watcher>],
+    phantom: &[u32],
+    propagated: &mut u64,
+    ticks: &mut u64,
+) -> Option<ClauseId> {
+    let mut arena = clauses.propagation();
+    while let Some(lit) = trail.next() {
+        *propagated += 1;
+        let code = lit.index();
+        let edges = binary.get(lit);
+        // Fixed graph borrows survive assignments. Each inner loop scans
+        // exactly one slice; the primary/overflow decision is outside it.
+        for span in [edges.primary, edges.extra] {
+            for edge in span {
+                let implied = edge.0;
+                if trail.is_true(implied) {
+                    continue;
+                }
+                let reason = edge.1;
+                if trail.is_true(implied.negate()) {
+                    return Some(reason);
+                }
+                // SAFETY: this graph literal is in the fixed domain and the
+                // value just tested is zero; nothing assigned it in between.
+                #[allow(unsafe_code)]
+                unsafe {
+                    trail.assign_undefined(implied, reason)
+                };
+            }
+        }
+        let mut watches = core::mem::take(&mut destinations[code]);
+        let phantom = phantom.get(code).copied().unwrap_or(0) as usize;
+        let charge = 1u64 + (((watches.len() + phantom) as u64) * 8).div_ceil(128);
+        *ticks = ticks.saturating_add(charge);
+        let mut cursor = Cursor::default();
+        let conflict = cursor.scan::<false>(
+            &mut watches,
+            lit.negate(),
+            &mut trail,
+            &mut arena,
+            destinations,
+        );
+        watches.truncate(cursor.write);
+        destinations[code] = watches;
+        if conflict.is_some() {
+            return conflict;
+        }
+    }
+    None
+}
+
+#[derive(Default)]
+struct Cursor {
+    read: usize,
+    write: usize,
+}
+
+impl Cursor {
+    /// The prefix transfers to the suffix exactly once, at the first removal.
+    /// The suffix never calls either phase, so call depth is bounded by two,
+    /// independently of the input or the number of removals. Const specialization
+    /// removes the compaction-state test from every kept entry in both loops.
+    // The fixed borrows let both phases live in the fixpoint driver without
+    // a Solver callback invalidating their bases at each implied assignment.
+    #[inline(always)]
+    fn scan<const COMPACT: bool>(
+        &mut self,
+        watches: &mut [Watcher],
+        false_lit: Lit,
+        trail: &mut PropagationTrail<'_>,
+        clauses: &mut PropagationArena<'_>,
+        destinations: &mut [Vec<Watcher>],
+    ) -> Option<ClauseId> {
+        debug_assert_eq!(self.write < self.read, COMPACT);
+        let mut write = self.write;
+        for read in self.read..watches.len() {
+            let watcher = watches[read];
+            if trail.is_true(watcher.blocker) {
+                if COMPACT {
+                    watches[write] = watcher;
+                    write += 1;
+                }
+                continue;
+            }
+            let Some(mut live) = clauses.live_clause(watcher.r) else {
+                if COMPACT {
+                    continue;
+                }
+                self.read = read + 1;
+                self.write = read;
+                return self.scan::<true>(watches, false_lit, trail, clauses, destinations);
+            };
+            let clause = live.lits();
+            debug_assert!(clause[0] == false_lit || clause[1] == false_lit);
+            let first = Lit::from_code(clause[0].code() ^ clause[1].code() ^ false_lit.code());
+            // Even satisfied exits keep the original eager normalization:
+            // subsequent inprocessing observes literal order.
+            clause[0] = first;
+            clause[1] = false_lit;
+            if trail.is_true(first) {
+                let kept = if COMPACT { write } else { read };
+                if COMPACT {
+                    watches[kept] = watcher;
+                    write += 1;
+                }
+                watches[kept].blocker = first;
+                continue;
+            }
+            let mut found = false;
+            for j in 2..clause.len() {
+                let literal = clause[j];
+                if trail.is_true(literal) {
+                    let kept = if COMPACT { write } else { read };
+                    if COMPACT {
+                        watches[kept] = watcher;
+                        write += 1;
+                    }
+                    watches[kept].blocker = literal;
+                    found = true;
+                    break;
+                }
+                if !trail.is_true(literal.negate()) {
+                    clause.swap(1, j);
+                    destinations[clause[1].negate().index()].push(Watcher {
+                        blocker: first,
+                        ..watcher
+                    });
+                    if !COMPACT {
+                        self.read = read + 1;
+                        self.write = read;
+                        return self.scan::<true>(watches, false_lit, trail, clauses, destinations);
+                    }
+                    found = true;
+                    break;
+                }
+            }
+            if found {
+                continue;
+            }
+            let kept = if COMPACT { write } else { read };
+            if COMPACT {
+                watches[kept] = watcher;
+            }
+            watches[kept].blocker = first;
+            let next_write = kept + 1;
+            if trail.is_true(first.negate()) {
+                // Preserve the unvisited tail without examining its blockers.
+                // In the prefix it is already in its final position.
+                if COMPACT {
+                    watches.copy_within(read + 1.., next_write);
+                }
+                self.read = watches.len();
+                self.write = next_write + watches.len() - read - 1;
+                return Some(live.reason());
+            }
+            // Units stay inside the scanner. Fixed value and reason arrays
+            // survive assignment-queue and destination-buffer growth.
+            let reason = live.reason();
+            // SAFETY: first is a valid clause literal. Its positive exit was
+            // handled before the tail scan and its negative exit just above;
+            // no assignment occurred in between, so it is still undefined.
+            #[allow(unsafe_code)]
+            unsafe {
+                trail.assign_undefined(first, reason)
+            };
+            if COMPACT {
+                write = next_write;
+            }
+        }
+        self.read = watches.len();
+        self.write = if COMPACT { write } else { watches.len() };
+        None
+    }
+}
