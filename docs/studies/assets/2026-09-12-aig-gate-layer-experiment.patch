+    /// Z3 `aig.cpp`'s two-level `mk_node` rules: `(a ∧ b) ∧ r` shapes.
+    /// Returns the reduced literal when a rule fires, `None` otherwise.
+    /// Purely syntactic on the node table — every rewrite is an
+    /// equivalence, so returning early is sound in both directions.
+    fn and_two_level(&mut self, x: Lit, y: Lit) -> Option<Sig> {
+        // Inspect one and-node input at a time (the rules are symmetric).
+        for (node, other) in [(x, y), (y, x)] {
+            let children = self.and_children.get(&node.var()).copied();
+            let Some((a, b)) = children else { continue };
+            let node_neg = node.is_neg();
+            let is_not = |l: Lit, r: Lit| l.var() == r.var() && l.is_pos() != r.is_pos();
+            // Contradiction: (a ∧ b) ∧ ¬a  or  (a ∧ b) ∧ ¬b  → false; and
+            // for the negated node: ¬(a ∧ b) ∧ (a ∧ b) → false (covered by
+            // the caller's complement check when shapes align exactly, but
+            // the child-level checks fire where they do not).
+            if !node_neg && (is_not(a, other) || is_not(b, other)) {
+                return Some(Sig::False);
