+    /// Retract AIG-memo entries journaled after `len` (the embedded
+    /// `pop` path: those entries' defining clauses die with the scope).
+    fn retract_gate_memos_since(&mut self, len: usize) {
+        while self.gate_journal.len() > len {
+            match self.gate_journal.pop() {
+                Some(GateKey::And(k)) => {
+                    self.and_memo.remove(&k);
+                }
+                Some(GateKey::Xor(k)) => {
+                    self.xor_memo.remove(&k);
                 }
+                Some(GateKey::Mux(k)) => {
+                    self.mux_memo.remove(&k);
+                }
+                None => break,
             }
         }
+        // Node-children entries follow the same lifetime as their memo
+        // entry (inserted together); drop those created after `len` by
+        // rebuilding lazily is not possible without a second journal —
+        // clear conservatively: a missing children entry only disables
+        // the two-level rules, never unsoundness.
+        self.and_children.clear();
+    }
