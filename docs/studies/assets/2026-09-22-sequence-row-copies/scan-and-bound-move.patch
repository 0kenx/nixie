--- a/nixie-theories/src/arithmetic/simplex/tests.rs
+++ b/nixie-theories/src/arithmetic/simplex/tests.rs
@@ -7,6 +7,51 @@ use num_rational::Rational64;

 use super::*;

+#[test]
+fn bound_trail_restores_exact_values_and_all_reasons_across_nested_scopes() {
+    use num_bigint::BigInt;
+    use num_rational::BigRational;
+
+    for wide in [false, true] {
+        let mut s = Simplex::new();
+        let x = s.new_var();
+        let idx = x as usize;
+        let base = if wide {
+            BigInt::from(1) << 100
+        } else {
+            BigInt::from(0)
+        };
+        let value = |offset: i64, delta: i64| BigDeltaRational {
+            real: BigRational::from_integer(&base + offset),
+            delta: BigRational::new(BigInt::from(delta), BigInt::from(3)),
+        };
+        s.push();
+        s.set_lower_exact(x, value(0, 0), (1..=7).collect());
+        s.set_upper_exact(x, value(10, 0), (8..=14).collect());
+        let original = (s.lower[idx].clone(), s.upper[idx].clone());
+        s.push();
+        s.set_lower_exact(x, value(1, 1), smallvec::smallvec![15, 16, 15]);
+        s.set_upper_exact(x, value(9, -1), smallvec::smallvec![17, 18, 17]);
+        let outer = (s.lower[idx].clone(), s.upper[idx].clone());
+        let trail_len = s.trail.len();
+        // A bound without antecedents must not consume the live bound.
+        s.set_lower_exact(x, value(2, 0), SmallVec::new());
+        s.set_upper_exact(x, value(8, 0), SmallVec::new());
+        assert_eq!(s.trail.len(), trail_len);
+        assert_eq!((s.lower[idx].clone(), s.upper[idx].clone()), outer);
+        s.push();
+        s.set_lower_exact(x, value(11, 0), (19..=25).collect());
+        assert!(s.pending_crossing.is_some());
+        s.pop();
+        assert!(s.pending_crossing.is_none());
+        assert_eq!((s.lower[idx].clone(), s.upper[idx].clone()), outer);
+        s.pop();
+        assert_eq!((s.lower[idx].clone(), s.upper[idx].clone()), original);
+        s.pop();
+        assert!(s.lower[idx].is_none() && s.upper[idx].is_none());
+    }
+}
