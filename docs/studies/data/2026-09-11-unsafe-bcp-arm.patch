+/// Unchecked signed-mark read for the subsumption kernels.
+///
+/// # Safety (caller contract, single invariant)
+/// `code < mark.len()`. Every caller derives the index from `Lit::code()` of
+/// a literal read out of a live clause in `self.clauses`, whose variable
+/// indices are `< num_vars`; the mark vector is sized `2 * num_vars` before
+/// the round starts and never shrinks mid-round. Release builds drop the
+/// checked index (the subsumption check loop's dominant per-candidate cost
+/// after the 2026-09-11 profile; see the study of that date). Single pass,
+/// callback-free: no aliasing between index derivation and access.
+#[inline(always)]
+#[allow(unsafe_code)]
+unsafe fn mark_read(mark: &[i8], code: u32) -> i8 {
+    debug_assert!((code as usize) < mark.len());
+    unsafe { *mark.get_unchecked(code as usize) }
+}
+
+/// Unchecked signed-mark write; same contract as [`mark_read`].
+#[inline(always)]
+#[allow(unsafe_code)]
+unsafe fn mark_write(mark: &mut [i8], code: u32, value: i8) {
+    debug_assert!((code as usize) < mark.len());
+    unsafe {
+        *mark.get_unchecked_mut(code as usize) = value;
     }
 }
 
