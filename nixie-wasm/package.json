{
  "name": "@cooljapan/nixie",
  "version": "0.3.2",
  "description": "WebAssembly bindings for Nixie SMT Solver - Pure Rust SMT solving in the browser",
  "main": "pkg/nixie_wasm.js",
  "types": "pkg/nixie_wasm.d.ts",
  "files": [
    "pkg/nixie_wasm.js",
    "pkg/nixie_wasm.d.ts",
    "pkg/nixie_wasm_bg.wasm",
    "pkg/nixie_wasm_bg.wasm.d.ts",
    "pkg-nodejs/nixie_wasm.js",
    "pkg-nodejs/nixie_wasm.d.ts",
    "pkg-nodejs/nixie_wasm_bg.wasm",
    "pkg-nodejs/nixie_wasm_bg.wasm.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --release",
    "build:nodejs": "wasm-pack build --target nodejs --release --out-dir pkg-nodejs",
    "build:bundler": "wasm-pack build --target bundler --release --out-dir pkg-bundler",
    "build:all": "npm run build && npm run build:nodejs && npm run build:bundler",
    "optimize": "command -v wasm-opt > /dev/null && wasm-opt -Oz -o pkg/nixie_wasm_bg.wasm pkg/nixie_wasm_bg.wasm && wasm-opt -Oz -o pkg-nodejs/nixie_wasm_bg.wasm pkg-nodejs/nixie_wasm_bg.wasm || echo 'wasm-opt not found, skipping optimization'",
    "test": "wasm-pack test --headless --chrome",
    "test:firefox": "wasm-pack test --headless --firefox",
    "prepublishOnly": "npm run build && npm run build:nodejs && npm run optimize"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cool-japan/nixie.git",
    "directory": "nixie-wasm"
  },
  "keywords": [
    "smt",
    "sat",
    "solver",
    "wasm",
    "webassembly",
    "smt-lib",
    "theorem-prover",
    "constraint-solver",
    "z3-alternative",
    "pure-rust"
  ],
  "author": "Nixie Contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cool-japan/nixie/issues"
  },
  "homepage": "https://github.com/cool-japan/nixie/tree/main/nixie-wasm#readme",
  "devDependencies": {},
  "dependencies": {},
  "engines": {
    "node": ">=14.0.0"
  },
  "exports": {
    ".": {
      "types": "./pkg/nixie_wasm.d.ts",
      "import": "./pkg/nixie_wasm.js",
      "require": "./pkg-nodejs/nixie_wasm.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
